# Terraform local state & cache  (NEVER commit state: it contains account IDs and can contain secrets)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable files that may hold real values (the .example file IS committed)
*.tfvars
*.tfvars.json
!terraform.tfvars.example

# Build artifacts (generated by scripts/build-lambdas.sh)
*.zip

# OS / editor / Python
.DS_Store
.idea/
.vscode/
__pycache__/
*.pyc
.venv/
